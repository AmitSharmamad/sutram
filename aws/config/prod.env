AWS_REGION=ap-south-1
ENVIRONMENT=prod
PROJECT_NAME=sutram

# VPC Configuration
VPC_CIDR=10.0.0.0/16
PUBLIC_SUBNET_1_CIDR=10.0.1.0/24
PUBLIC_SUBNET_2_CIDR=10.0.2.0/24
PRIVATE_SUBNET_1_CIDR=10.0.11.0/24
PRIVATE_SUBNET_2_CIDR=10.0.12.0/24

# RDS Configuration
DB_INSTANCE_CLASS=db.t3.small
DB_ALLOCATED_STORAGE=100
DB_NAME=sutram_prod
DB_USERNAME=sutram_user
DB_PASSWORD=change_me_prod

# ECS Configuration
CPU=512
MEMORY=1024

# Application Configuration
WEB_PORT=8080
LIVE_PORT=8081
DEPLOYMENT_PORT=8082

# OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-prod
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-prod
GOOGLE_OAUTH_REDIRECT_URL=https://your-production-domain/api/auth/oauth/google/callback
