# Production Environment Configuration
ENVIRONMENT=prod
PROJECT_NAME=sutram

# Stack Names
INFRA_STACK_NAME=sutram-infra-prod
PG_STACK_NAME=sutram-pg-prod
CH_STACK_NAME=sutram-ch-ecs-prod
WEB_STACK_NAME=sutram-web-prod
LIVE_STACK_NAME=sutram-live-prod
DEPLOYMENT_STACK_NAME=sutram-deployment-prod

# Instance Configuration
DATABASE_INSTANCE_CLASS=db.r5.large
CLICKHOUSE_INSTANCE_TYPE=c5n.large
WEB_INSTANCE_TYPE=t3.medium
LIVE_INSTANCE_TYPE=t3.medium
DEPLOYMENT_INSTANCE_TYPE=t3.small

# ClickHouse ECS Configuration
IMAGE_TAG=latest
TASK_CPU=1024
TASK_MEMORY=2048

# Scaling Configuration
WEB_DESIRED_CAPACITY=2
WEB_MIN_SIZE=2
WEB_MAX_SIZE=10

LIVE_DESIRED_CAPACITY=2
LIVE_MIN_SIZE=2
LIVE_MAX_SIZE=10

DEPLOYMENT_DESIRED_CAPACITY=1
DEPLOYMENT_MIN_SIZE=1
DEPLOYMENT_MAX_SIZE=3

# Production Settings
USE_SINGLE_NAT_GATEWAY=false
DISABLE_MULTI_AZ=false
MINIMAL_STORAGE=false

# SSH Key (should be set for production)
KEY_NAME=sutram-prod-key
