# Development Environment Configuration
ENVIRONMENT=dev
PROJECT_NAME=sutram

# Stack Names
INFRA_STACK_NAME=sutram-infra-dev
PG_STACK_NAME=sutram-pg-dev
CH_STACK_NAME=sutram-ch-dev
WEB_STACK_NAME=sutram-web-dev
LIVE_STACK_NAME=sutram-live-dev
DEPLOYMENT_STACK_NAME=sutram-deployment-dev

# Instance Configuration
DATABASE_INSTANCE_CLASS=db.t3.micro
CLICKHOUSE_INSTANCE_TYPE=t3.micro
WEB_INSTANCE_TYPE=t3.micro
LIVE_INSTANCE_TYPE=t3.micro
DEPLOYMENT_INSTANCE_TYPE=t3.micro

# Scaling Configuration
WEB_DESIRED_CAPACITY=1
WEB_MIN_SIZE=1
WEB_MAX_SIZE=2

LIVE_DESIRED_CAPACITY=1
LIVE_MIN_SIZE=1
LIVE_MAX_SIZE=2

DEPLOYMENT_DESIRED_CAPACITY=1
DEPLOYMENT_MIN_SIZE=1
DEPLOYMENT_MAX_SIZE=1

# Cost Optimization Settings
USE_SINGLE_NAT_GATEWAY=true
DISABLE_MULTI_AZ=true
MINIMAL_STORAGE=true

# SSH Key (optional - leave empty if no SSH access needed)
KEY_NAME=
