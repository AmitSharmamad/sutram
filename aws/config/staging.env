# Environment configuration for staging
ENVIRONMENT=staging
PROJECT_NAME=sutram

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# Stack Names (will be prefixed with PROJECT_NAME-ENVIRONMENT)
NETWORKING_STACK_NAME=networking
DATA_STACK_NAME=data
APP_INFRA_STACK_NAME=app-infra
APP_SERVICES_STACK_NAME=app-services
CDN_STACK_NAME=cdn

# Domain Configuration (optional)
DOMAIN_NAME=staging.sutram.com
CREATE_ROUTE53_HOSTED_ZONE=false
ROUTE53_HOSTED_ZONE_ID=
CERTIFICATE_ARN=

# Database Configuration
DATABASE_INSTANCE_CLASS=db.t3.small
REDIS_NODE_TYPE=cache.t3.small
CLICKHOUSE_INSTANCE_TYPE=t3.medium

# Application Configuration
WEB_APP_DESIRED_COUNT=2
LIVE_TRADING_DESIRED_COUNT=1
WEB_APP_IMAGE_TAG=latest
LIVE_TRADING_IMAGE_TAG=latest

# Security (these will be created automatically by CloudFormation)
# You'll need to update these in AWS Secrets Manager after deployment
DATABASE_USERNAME=admin
DHAN_ACCESS_TOKEN=
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
ANGELONE_API_KEY=
ANGELONE_ACCESS_TOKEN=
HDFC_ACCESS_TOKEN=
SHAREKHAN_API_KEY=
SHAREKHAN_ACCESS_TOKEN=
JWT_SECRET=
ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
